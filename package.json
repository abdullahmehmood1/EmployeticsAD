{
  "name": "employetics-ad",
  "version": "1.0.0",
  "description": "40-second complete motion graphics video commercial for Employetics (Remotion + Neural TTS + Colab GPU rendering)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "tsc --noEmit",
    "audio": "python scripts/generate_audio.py",
    "render": "python scripts/render_video.py",
    "render:raw": "remotion render src/index.ts EmployeticsAd out/employetics-ad.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.250",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.250",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
